# Export settings in the API process environment. The diagnostic CLI uses flags.
TELEMETRY_SOURCE=hardware
# Hardware modes: raw, quaternion, both, raw_fusion (laptop demo fallback).
DEVICE_ID=
DEVICE_FORMAT=raw
# For raw_fusion only. Output right, up, back for IMUs 1 through 4.
# RAW_IMU_AXES=-y,z,-x;-y,z,-x;-y,z,-x;-y,z,-x
POSTURE_WARNING_DEG=20
POSTURE_WARNING_SECONDS=2
